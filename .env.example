# === Supabase ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection — used by crawler/pipeline CLI (psycopg)
# Dashboard → Project Settings → Database → Connection Pooler → Transaction
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# === LLM ===
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === Email ===
RESEND_API_KEY=your-resend-key

# === AIVIZENS digest 模块（今日AI / AI大神 从 Gmail digest 邮件取内容）===
# Mac mini headless 用 IMAP + 应用专用密码读 Gmail（在 Google 账号开 2FA 后生成 16 位 app password）
AI_GMAIL_IMAP_USER=peter.fan.happy@gmail.com
AI_GMAIL_IMAP_PASSWORD=your-16-char-app-password
# AI_GMAIL_IMAP_HOST=imap.gmail.com          # 默认即可
# AI_DIGEST_SENDER=paul.fan.2200@gmail.com   # 默认即可
# 选图用 Qwen 多模态模型（DashScope OpenAI 兼容端点，须支持视觉输入）
QWEN_API_KEY=your-dashscope-key
# QWEN_VL_MODEL=qwen3.7-plus                 # 默认即可
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_IMAGE_BUCKET=ai-brief-images            # Supabase Storage 公开桶（migration 0010 建）

# === Monitoring ===
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
HEALTHCHECKS_PING_URL=https://hc-ping.com/your-uuid

# === Admin ===
ADMIN_TOKEN=replace-with-32-byte-random-token

# === Behavior ===
CRAWL_MAX_QPS_PER_DOMAIN=1.0
LOG_LEVEL=INFO

# === Local Dev (使用 docker-compose 的本地 Postgres 时) ===
# 把 SUPABASE_URL 改成本地连接字符串需要 supabase-py 不直接支持，
# 本地开发推荐直接连 Supabase 项目（有免费 staging 项目）。

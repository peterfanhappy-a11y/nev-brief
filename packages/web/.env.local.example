# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test-only escape hatch; ignored unless NODE_ENV=test.
TURNSTILE_TEST_BYPASS=false

# Server-only HMAC secret for durable subscription rate-limit keys.
SUBSCRIPTION_HASH_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only; required to send confirmation and welcome emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=aivizens.daily@aivizens.com

# Web (server-only base used in confirmation links)
WEB_BASE_URL=https://aivizens.com
NEXT_PUBLIC_WEB_BASE_URL=https://aivizens.com

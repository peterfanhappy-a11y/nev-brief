<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ brief.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;font-family:-apple-system,'PingFang SC','Microsoft YaHei',Helvetica,Arial,sans-serif;">
<!-- preheader（隐藏预览文字）-->
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ brief.preheader }}</div>

{% macro divider() %}
<tr><td style="padding:0;"><div style="border-top:1px solid #e5e7eb;height:1px;line-height:1px;font-size:1px;">&nbsp;</div></td></tr>
{% endmacro %}

{% macro section_header(title) %}
<tr><td style="padding:26px 0 12px;">
  <div style="background:#000000;color:#ffffff;font-size:15px;font-weight:800;letter-spacing:4px;padding:12px 0;text-align:center;">{{ title }}</div>
</td></tr>
{% endmacro %}

{% macro digest_section(section, title) %}
{% if section %}
<tr><td style="padding:12px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px solid #111827;border-radius:12px;">
    <tr><td style="padding:12px 18px 0;">
      <span style="font-size:11px;font-weight:700;color:{{ theme_color(section.theme) }};letter-spacing:2px;">{{ title }}</span>
    </td></tr>
    {% if section.header_image %}
    <tr><td style="padding:10px 0 4px;">
      <img src="{{ section.header_image }}" width="663" alt="{{ section.header_image_alt }}" style="display:block;width:100%;height:auto;">
    </td></tr>
    {% endif %}
    {% if section.subtitle %}
    <tr><td style="padding:12px 18px 0;">
      <div style="font-size:17px;font-weight:800;color:#111827;line-height:1.5;">{{ section.subtitle }}</div>
    </td></tr>
    {% endif %}
    {% for s in section.stories %}
    <tr><td style="padding:14px 18px;{% if not loop.first or section.subtitle %}border-top:1px solid #e5e7eb;{% endif %}">
      {% if s.label %}<div style="font-size:11px;color:#9ca3af;font-weight:600;margin-bottom:5px;letter-spacing:1px;">{{ s.label }}</div>{% endif %}
      {% if theme_label(section.theme) == 'AI工程' %}
      {% set field_label, field_separator, field_title = s.headline.partition('：') %}
      <div style="font-size:16px;font-weight:800;color:#111827;line-height:1.45;">{{ loop.index }}. {{ field_label }}：{% if field_separator %}<br>{{ field_title }}{% endif %}</div>
      {% elif s.url %}
      <a href="{{ s.url }}" style="text-decoration:none;"><span style="font-size:16px;font-weight:800;color:#111827;line-height:1.45;">{{ loop.index }}. {{ s.headline }}</span></a>
      {% else %}
      <span style="font-size:16px;font-weight:800;color:#111827;line-height:1.45;">{{ loop.index }}. {{ s.headline }}</span>
      {% endif %}
      <div style="font-size:14px;line-height:1.75;color:#374151;margin-top:6px;">{{ s.summary }}</div>
      {% if s.url and section.cta_label %}
      <div style="margin-top:8px;"><a href="{{ s.url }}" style="font-size:12px;color:#4F46E5;text-decoration:none;font-weight:600;">{{ section.cta_label }} →</a></div>
      {% endif %}
    </td></tr>
    {% endfor %}
  </table>
</td></tr>
{% endif %}
{% endmacro %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;">
<tr><td align="center" style="padding:16px 10px;">
<table role="presentation" width="667" cellpadding="0" cellspacing="0" style="width:667px;max-width:667px;background:#ffffff;">

  <!-- ① Header：全宽 logo + 日期/阅读时长（无社交图标）-->
  <tr><td style="padding:0 0 18px;text-align:center;">
    <img src="{{ logo_email_url }}" width="667" alt="AIVIZENS 趋势" style="display:block;width:100%;max-width:667px;height:auto;">
    <div style="font-size:12px;color:#9ca3af;margin-top:16px;letter-spacing:1px;">{{ date_human }} · 5 分钟阅读</div>
  </td></tr>

  <!-- ②③ 问候 + 编辑导语 + 今日简报（同一张全宽圆角边框卡）-->
  <tr><td style="padding:6px 0 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px solid #111827;border-radius:12px;">
      <tr><td style="padding:20px 22px 12px;">
        <table role="presentation" cellpadding="0" cellspacing="0"><tr>
          <td style="vertical-align:middle;"><img src="{{ author_photo_url }}" width="38" height="38" alt="{{ author_name }}" style="border-radius:50%;display:block;"></td>
          <td style="vertical-align:middle;padding-left:10px;font-size:14px;color:#374151;font-weight:600;">{{ author_name }}</td>
        </tr></table>
        <p style="margin:16px 0 10px;font-size:16px;line-height:1.8;color:#111827;font-weight:700;">
          早上好{% if greeting_name %}，{{ greeting_name }}{% endif %}！以下是今天最值得关注的 AI 洞察，5 分钟带你看懂全局。
        </p>
        {% if brief.editorial %}
        <p style="margin:0 0 4px;font-size:15px;line-height:1.85;color:#374151;">{{ brief.editorial }}</p>
        {% endif %}
      </td></tr>
      <tr><td style="padding:6px 22px 20px;">
        <div style="font-size:12px;font-weight:800;color:#111827;letter-spacing:2px;margin-bottom:8px;">今日 AI 简报</div>
        {% for b in brief.intro_bullets %}
        <div style="font-size:14px;line-height:1.9;color:#374151;">{{ b }}</div>
        {% endfor %}
      </td></tr>
    </table>
  </td></tr>

  <!-- 4. 今日精选：模块 1&2 digest 驱动（各一张卡=头图+多条 story）；
       模块 3&4 走 featured（内容生成待定义，暂空则省略）-->
  {{ section_header('今 日 精 选') }}
  {{ digest_section(brief.today_ai, '一、今日AI' if brief.version == 2 else (theme_label(brief.today_ai.theme) if brief.today_ai else '')) }}
  {{ digest_section(brief.ai_masters, '二、AI大神' if brief.version == 2 else (theme_label(brief.ai_masters.theme) if brief.ai_masters else '')) }}
  {% for item in brief.featured if brief.version != 2 %}
  <tr><td style="padding:12px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px solid #111827;border-radius:12px;">
      <!-- 分类标签 kicker -->
      <tr><td style="padding:12px 18px 0;">
        <span style="font-size:11px;font-weight:700;color:{{ theme_color(item.theme) }};letter-spacing:2px;">{{ theme_label(item.theme) }}</span>
      </td></tr>
      <!-- emoji + 标题 -->
      <tr><td style="padding:8px 18px 12px;">
        <a href="{{ item.url }}" style="text-decoration:none;"><span style="font-size:19px;font-weight:800;color:#111827;line-height:1.4;">{{ item.headline }}</span></a>
      </td></tr>
      {% if item.og_image %}
      <tr><td style="padding:0 18px 14px;">
        <img src="{{ item.og_image }}" width="627" alt="" style="display:block;width:100%;height:auto;border-radius:8px;">
      </td></tr>
      {% endif %}
      <tr><td style="padding:0 18px 16px;">
        <div style="font-size:13px;font-weight:800;color:#111827;margin-bottom:6px;">详情：</div>
        <ul style="margin:0 0 14px;padding-left:20px;">
          {% for d in item.details %}
          <li style="font-size:14px;line-height:1.75;color:#374151;margin-bottom:3px;">{{ d }}</li>
          {% endfor %}
        </ul>
        <div style="font-size:14px;line-height:1.75;color:#374151;">
          <span style="font-weight:800;color:#111827;">为什么重要：</span>{{ item.significance }}
        </div>
        <div style="margin-top:12px;"><a href="{{ item.url }}" style="font-size:13px;color:#4F46E5;text-decoration:none;font-weight:600;">阅读原文（{{ item.source_name }}）→</a></div>
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  {{ divider() }}

  <!-- ⑤ 工具学习模块（digest 驱动，同今日精选格式）-->
  {{ section_header('工 具 学 习') }}
  {{ digest_section(brief.ai_research, '三、AI研究' if brief.version == 2 else (theme_label(brief.ai_research.theme) if brief.ai_research else '')) }}
  {% if brief.version != 2 %}{{ digest_section(brief.ai_engineering, theme_label(brief.ai_engineering.theme) if brief.ai_engineering else '') }}{% endif %}
  {{ digest_section(brief.agent_tools, '四、Agent工具' if brief.version == 2 else (theme_label(brief.agent_tools.theme) if brief.agent_tools else '')) }}
  {% if brief.version != 2 and brief.tools %}
  <tr><td style="padding:12px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px solid #111827;border-radius:12px;">
    <tr><td style="padding:16px 20px;">
      <div style="font-size:14px;font-weight:800;color:#111827;margin-bottom:10px;">🔥 热门 AI 工具</div>
      {% for t in brief.tools %}
      <div style="font-size:14px;line-height:1.7;color:#374151;margin-bottom:6px;">
        <a href="{{ t.url }}" style="color:#111827;font-weight:700;text-decoration:none;">{{ t.name }}</a> — {{ t.one_liner }}
      </div>
      {% endfor %}
    </td></tr></table>
  </td></tr>
  {% endif %}
  {% if brief.version != 2 and brief.daily_tip %}
  <tr><td style="padding:12px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:2px solid #111827;border-radius:12px;">
    <tr><td style="padding:16px 20px;">
      <div style="font-size:14px;font-weight:800;color:#111827;margin-bottom:8px;">🎓 热门 AI 课堂</div>
      <div style="font-size:14px;line-height:1.75;color:#374151;">
        <span style="font-weight:800;color:#111827;">{{ brief.daily_tip.title }}</span>{{ brief.daily_tip.body }}
      </div>
    </td></tr></table>
  </td></tr>
  {% endif %}

  <!-- ⑥ 昨日最热 -->
  {% if brief.version != 2 and brief.yesterday_top %}
  {{ divider() }}
  <tr><td style="padding:18px 28px;">
    <span style="font-size:13px;font-weight:700;color:#6b7280;">如果您错过了：</span>
    <a href="{{ brief.yesterday_top.url }}" style="font-size:14px;color:#111827;text-decoration:none;font-weight:600;">{{ brief.yesterday_top.headline }}</a>
  </td></tr>
  {% endif %}

  {{ divider() }}

  <!-- ⑦ 评分 -->
  <tr><td style="padding:24px 28px;text-align:center;">
    <div style="font-size:14px;font-weight:700;color:#374151;margin-bottom:14px;">今天的内容怎么样？</div>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=3" style="text-decoration:none;font-size:26px;padding:0 12px;">🤩</a>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=2" style="text-decoration:none;font-size:26px;padding:0 12px;">🙂</a>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=1" style="text-decoration:none;font-size:26px;padding:0 12px;">😐</a>
    <div style="font-size:11px;color:#9ca3af;margin-top:10px;">很棒 · 还行 · 一般</div>
  </td></tr>

  <!-- ⑧ Footer：仅文字（无 logo / 无社交图标）-->
  <tr><td style="padding:26px 28px 30px;background:#111827;text-align:center;">
    <div style="font-size:12px;color:#9ca3af;line-height:1.7;">
      由 AIVIZENS 出品 · 每日 5 分钟看懂 AI<br>
      <a href="{{ unsubscribe_url }}" style="color:#9ca3af;">一键退订</a> ·
      <a href="{{ web_base }}" style="color:#9ca3af;">访问网站</a>
    </div>
  </td></tr>

</table>
</td></tr></table>
</body></html>

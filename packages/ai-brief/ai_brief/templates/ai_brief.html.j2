<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>{{ brief.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'PingFang SC','Microsoft YaHei',Helvetica,Arial,sans-serif;">
<!-- preheader（隐藏预览文字）-->
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ brief.preheader }}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
<tr><td align="center" style="padding:16px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">

  <!-- ① Header：作者 + 日期 + 社交 -->
  <tr><td style="padding:20px 24px;border-bottom:1px solid #eee;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td align="left" style="vertical-align:middle;">
        <img src="{{ author_photo_url }}" width="36" height="36" alt="{{ author_name }}"
             style="border-radius:50%;vertical-align:middle;">
        <span style="font-size:14px;font-weight:600;color:#111;padding-left:8px;vertical-align:middle;">{{ author_name }}</span>
        <span style="font-size:12px;color:#999;padding-left:8px;vertical-align:middle;">{{ date_human }}</span>
      </td>
      <td align="right" style="vertical-align:middle;">
        {% for name, icon_url, href in social_icons %}
        <a href="{{ href }}" style="text-decoration:none;padding-left:6px;"><img src="{{ icon_url }}" width="20" height="20" alt="{{ name }}" style="vertical-align:middle;border-radius:4px;"></a>
        {% endfor %}
      </td>
    </tr></table>
  </td></tr>

  <!-- ② 品牌横幅 -->
  <tr><td style="padding:24px;background:linear-gradient(135deg,#4F46E5,#0EA5E9);text-align:center;">
    <img src="{{ logo_email_url }}" height="32" alt="AIVIZENS" style="display:block;margin:0 auto 8px;">
    <div style="font-size:22px;font-weight:800;color:#ffffff;letter-spacing:1px;">AIVIZENS 趋势</div>
    <div style="font-size:12px;color:#e0e7ff;margin-top:4px;">{{ banner_tagline }}</div>
  </td></tr>

  <!-- ③ 欢迎 + 今日AI简报 -->
  <tr><td style="padding:24px 24px 8px;">
    <p style="margin:0 0 14px;font-size:15px;line-height:1.7;color:#333;">
      👋 欢迎回来！以下是今天最值得关注的 AI 动态，5 分钟带你看懂全局。
    </p>
    <div style="background:#f8f9fb;border-radius:10px;padding:16px 18px;">
      <div style="font-size:13px;font-weight:700;color:#4F46E5;margin-bottom:10px;">📋 今日 AI 简报</div>
      {% for b in brief.intro_bullets %}
      <div style="font-size:14px;line-height:1.8;color:#333;">{{ b }}</div>
      {% endfor %}
    </div>
  </td></tr>

  <!-- ④ 今日精选（4 图文板块）-->
  <tr><td style="padding:20px 24px 4px;">
    <div style="font-size:18px;font-weight:800;color:#111;border-left:4px solid #4F46E5;padding-left:10px;">今日精选</div>
  </td></tr>
  {% for item in brief.featured %}
  <tr><td style="padding:14px 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #eee;border-radius:10px;overflow:hidden;">
      <tr><td>
        {% if item.og_image %}
        <img src="{{ item.og_image }}" width="552" alt="" style="display:block;width:100%;height:auto;">
        {% else %}
        <div style="height:120px;background:{{ theme_color(item.theme) }};color:#fff;text-align:center;line-height:120px;font-size:18px;font-weight:700;">{{ item.theme_label }}</div>
        {% endif %}
      </td></tr>
      <tr><td style="padding:16px 18px;">
        <div style="display:inline-block;font-size:11px;font-weight:700;color:#fff;background:{{ theme_color(item.theme) }};border-radius:4px;padding:2px 8px;margin-bottom:8px;">{{ item.theme_label }}</div>
        <a href="{{ item.url }}" style="text-decoration:none;"><div style="font-size:17px;font-weight:700;color:#111;line-height:1.4;margin-bottom:10px;">{{ item.headline }}</div></a>
        <ul style="margin:0 0 12px;padding-left:18px;">
          {% for d in item.details %}
          <li style="font-size:14px;line-height:1.7;color:#444;">{{ d }}</li>
          {% endfor %}
        </ul>
        <div style="font-size:13px;line-height:1.7;color:#666;background:#f8f9fb;border-radius:8px;padding:10px 12px;">
          <strong style="color:#4F46E5;">意义：</strong>{{ item.significance }}
        </div>
        <div style="margin-top:10px;"><a href="{{ item.url }}" style="font-size:13px;color:#4F46E5;text-decoration:none;">阅读原文（{{ item.source_name }}）→</a></div>
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  <!-- ⑤ 今日速览 -->
  <tr><td style="padding:20px 24px 4px;">
    <div style="font-size:18px;font-weight:800;color:#111;border-left:4px solid #0EA5E9;padding-left:10px;">今日速览</div>
  </td></tr>
  {% if brief.tools %}
  <tr><td style="padding:10px 24px;">
    <div style="font-size:14px;font-weight:700;color:#111;margin-bottom:8px;">🔥 热门 AI 工具</div>
    {% for t in brief.tools %}
    <div style="font-size:14px;line-height:1.7;color:#444;margin-bottom:4px;">
      <a href="{{ t.url }}" style="color:#111;font-weight:600;text-decoration:none;">{{ t.name }}</a> — {{ t.one_liner }}
    </div>
    {% endfor %}
  </td></tr>
  {% endif %}
  {% if brief.daily_tip %}
  <tr><td style="padding:10px 24px;">
    <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px 16px;">
      <div style="font-size:14px;font-weight:700;color:#92400e;margin-bottom:6px;">🎓 每日课堂 · {{ brief.daily_tip.title }}</div>
      <div style="font-size:14px;line-height:1.7;color:#444;">{{ brief.daily_tip.body }}</div>
    </div>
  </td></tr>
  {% endif %}
  {% if brief.quick_hits %}
  <tr><td style="padding:10px 24px;">
    <div style="font-size:14px;font-weight:700;color:#111;margin-bottom:8px;">📰 AI 其他</div>
    {% for q in brief.quick_hits %}
    <div style="font-size:14px;line-height:1.7;color:#444;margin-bottom:4px;">
      • {% if q.url %}<a href="{{ q.url }}" style="color:#444;text-decoration:none;">{{ q.text }}</a>{% else %}{{ q.text }}{% endif %}
    </div>
    {% endfor %}
  </td></tr>
  {% endif %}

  <!-- ⑥ 昨日最热 -->
  {% if brief.yesterday_top %}
  <tr><td style="padding:14px 24px;">
    <div style="background:#f0f4ff;border-radius:10px;padding:14px 16px;">
      <span style="font-size:13px;font-weight:700;color:#4F46E5;">如果您错过了：</span>
      <a href="{{ brief.yesterday_top.url }}" style="font-size:14px;color:#111;text-decoration:none;">{{ brief.yesterday_top.headline }}</a>
    </div>
  </td></tr>
  {% endif %}

  <!-- ⑦ 评分 -->
  <tr><td style="padding:20px 24px;text-align:center;border-top:1px solid #eee;">
    <div style="font-size:14px;font-weight:600;color:#333;margin-bottom:12px;">今天的内容怎么样？</div>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=3" style="text-decoration:none;font-size:20px;padding:0 10px;">🤩</a>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=2" style="text-decoration:none;font-size:20px;padding:0 10px;">🙂</a>
    <a href="{{ rate_base }}?d={{ delivery_id }}&amp;s=1" style="text-decoration:none;font-size:20px;padding:0 10px;">😐</a>
    <div style="font-size:11px;color:#aaa;margin-top:8px;">很棒 · 还行 · 一般</div>
  </td></tr>

  <!-- ⑧ Footer -->
  <tr><td style="padding:20px 24px;background:#f8f9fb;text-align:center;">
    <div style="font-size:12px;color:#999;line-height:1.7;">
      由 AIVIZENS 出品 · 每日 5 分钟看懂 AI<br>
      <a href="{{ unsubscribe_url }}" style="color:#999;">一键退订</a> ·
      <a href="{{ web_base }}" style="color:#999;">访问网站</a>
    </div>
  </td></tr>

</table>
</td></tr></table>
</body></html>
